[Unit]
Description=SpotMicro - pantalla HDMI (menu, estado y pagina web)
After=systemd-user-sessions.service spotmicro-web.service getty@tty1.service
# o el panel o la consola normal en tty1, nunca los dos
Conflicts=getty@tty1.service

[Service]
Type=simple
User=luislecinana
# sesion de logind en tty1: hace falta para abrir el navegador (cage) en la pantalla
PAMName=spotmicro-pantalla
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=tty
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=TERM=linux LANG=C.UTF-8
ExecStart=/usr/bin/python3 /home/luislecinana/spotmicro/pantalla/panel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
